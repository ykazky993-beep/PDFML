{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PDFML",
  "scopeName": "source.pdfml",

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pdfml",
          "match": "#.*$"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pdfml",
          "match": "\\b(title|text|heading|paragraph|image|table|row|cell|box|page|style|font|color|margin|padding|align|line|circle|rect|qrcode|barcode|let|if|else|for|component|import|include)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pdfml",
          "begin": "\"",
          "end": "\""
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pdfml",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },

    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.pdfml",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pdfml",
          "match": "=|\\+|-|\\*|/|==|!=|<=|>=|<|>"
        }
      ]
    }
  }
}
