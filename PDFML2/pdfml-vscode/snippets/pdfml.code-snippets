{
  "Document": {
    "prefix": "doc",
    "body": [
      "title \"${1:Document}\"",
      "",
      "text \"${2:Hello World}\""
    ],
    "description": "Create a basic PDFML document"
  },

  "Title": {
    "prefix": "title",
    "body": [
      "title \"${1:Title}\""
    ],
    "description": "Insert a title"
  },

  "Text": {
    "prefix": "text",
    "body": [
      "text \"${1:Text}\""
    ],
    "description": "Insert text"
  },

  "Heading": {
    "prefix": "heading",
    "body": [
      "heading ${1:1} \"${2:Heading}\""
    ],
    "description": "Insert heading"
  },

  "Paragraph": {
    "prefix": "p",
    "body": [
      "paragraph \"${1:Paragraph}\""
    ],
    "description": "Insert paragraph"
  },

  "Image": {
    "prefix": "img",
    "body": [
      "image \"${1:image.png}\""
    ],
    "description": "Insert image"
  },

  "Table": {
    "prefix": "table",
    "body": [
      "table {",
      "\trow {",
      "\t\tcell \"${1:Column 1}\"",
      "\t\tcell \"${2:Column 2}\"",
      "\t}",
      "}"
    ],
    "description": "Insert table"
  },

  "Box": {
    "prefix": "box",
    "body": [
      "box {",
      "\t${1}",
      "}"
    ],
    "description": "Insert box"
  },

  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "}"
    ],
    "description": "Insert if statement"
  },

  "For": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:range(10)} {",
      "\t${3}",
      "}"
    ],
    "description": "Insert for loop"
  }
}
